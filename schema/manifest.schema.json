{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://runnerx.app/manifest.schema.json",
  "title": "runnerx script manifest",
  "type": "object",
  "required": ["name", "entry"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1, "description": "Display name shown in the script list." },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "description": "Stable id. Defaults to the script directory name." },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "icon": { "type": "string", "description": "Path to a PNG (relative to script directory)." },
    "category": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "readme": { "type": "string", "description": "Path to a markdown readme. Defaults to README.md if present." },
    "entry": { "$ref": "#/definitions/entry" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-platform overrides for entry / lifecycle.",
      "properties": {
        "windows": { "$ref": "#/definitions/platformOverride" },
        "macos": { "$ref": "#/definitions/platformOverride" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": { "$ref": "#/definitions/command" },
        "uninstall": { "$ref": "#/definitions/command" },
        "preRun": { "$ref": "#/definitions/command" }
      }
    },
    "inputs": { "type": "array", "items": { "$ref": "#/definitions/input" } },
    "outputs": { "type": "array", "items": { "$ref": "#/definitions/output" } }
  },
  "definitions": {
    "command": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "shell": { "type": "boolean", "default": false },
        "cwd": { "type": "string" }
      }
    },
    "entry": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "shell": { "type": "boolean", "default": false },
        "cwd": { "type": "string" },
        "argsMode": {
          "type": "string",
          "enum": ["env", "argv", "stdin-json"],
          "default": "env",
          "description": "How input values are passed to the script."
        }
      }
    },
    "platformOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": { "$ref": "#/definitions/entry" },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "install": { "$ref": "#/definitions/command" },
            "uninstall": { "$ref": "#/definitions/command" },
            "preRun": { "$ref": "#/definitions/command" }
          }
        }
      }
    },
    "whenClause": {
      "type": "object",
      "description": "Field is only shown when these other fields match. Each value can be a literal or array of allowed values.",
      "additionalProperties": {
        "oneOf": [
          { "type": ["string", "number", "boolean", "null"] },
          { "type": "array", "items": { "type": ["string", "number", "boolean"] } }
        ]
      }
    },
    "input": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "default": {},
        "placeholder": { "type": "string" },
        "when": { "$ref": "#/definitions/whenClause" }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "string" },
            "multiline": { "type": "boolean", "default": false },
            "pattern": { "type": "string" },
            "minLength": { "type": "integer", "minimum": 0 },
            "maxLength": { "type": "integer", "minimum": 0 }
          },
          "required": ["type"]
        },
        {
          "properties": {
            "type": { "const": "number" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number" },
            "integer": { "type": "boolean", "default": false }
          },
          "required": ["type"]
        },
        {
          "properties": {
            "type": { "const": "boolean" }
          },
          "required": ["type"]
        },
        {
          "properties": {
            "type": { "const": "enum" },
            "options": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "type": "string" },
                  {
                    "type": "object",
                    "required": ["value"],
                    "properties": {
                      "value": { "type": ["string", "number", "boolean"] },
                      "label": { "type": "string" }
                    }
                  }
                ]
              }
            },
            "multiple": { "type": "boolean", "default": false }
          },
          "required": ["type", "options"]
        },
        {
          "properties": {
            "type": { "const": "file" },
            "accept": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["type"]
        },
        {
          "properties": {
            "type": { "const": "files" },
            "accept": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["type"]
        },
        {
          "properties": {
            "type": { "const": "directory" }
          },
          "required": ["type"]
        },
        {
          "properties": {
            "type": { "const": "password" }
          },
          "required": ["type"]
        },
        {
          "properties": {
            "type": { "const": "date" },
            "minDate": { "type": "string" },
            "maxDate": { "type": "string" }
          },
          "required": ["type"]
        },
        {
          "properties": {
            "type": { "const": "json" }
          },
          "required": ["type"]
        }
      ]
    },
    "output": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["file", "directory", "text"] },
        "save": { "type": "boolean", "default": false, "description": "If true, prompt the user to choose a save path before running." },
        "suggested": { "type": "string", "description": "Template for default path. Use {{input_id.stem|name|ext|path}}." },
        "accept": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
